{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@9.0.6",
  "scripts": {
    "dev": "vite",
    "optimize": "tsx optimize-images.ts",
    "validate:posts": "tsx scripts/validatePostsMeta.ts",
    "generate-sitemap": "tsx src/utils/generate-sitemap.ts",
    "generate:llms": "tsx scripts/generateLlmsTxt.ts",
    "prerender": "tsx scripts/prerenderMeta.ts",
    "prebuild": "npm run validate:posts && npm run generate:llms && npm run generate-sitemap",
    "build": "npm run optimize && tsc && vite build && npm run prerender",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --host",
    "build:css": "tailwindcss -i ./src/input.css -o ./dist/output.css --watch",
    "start": "npm run optimize && serve dist"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tanstack/react-query": "^5.101.4",
    "aos": "^2.3.4",
    "autoprefixer": "^10.5.4",
    "axios": "^1.19.0",
    "date-fns": "^3.6.0",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.0",
    "lucide-react": "^0.416.0",
    "postcss": "^8.5.26",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.30.6",
    "serve": "^14.2.6",
    "sharp": "^0.35.3",
    "sitemap": "^8.0.3"
  },
  "devDependencies": {
    "@types/aos": "^3.0.8",
    "@types/date-fns": "^2.6.3",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-helmet": "^6.1.11",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-mkcert": "^1.17.12"
  }
}